<Project>
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <AnalysisLevel>latest-recommended</AnalysisLevel>
        <!-- CA1716: VB 'Shared' keyword conflict -->
        <!-- CA1848: Standard ILogger calls vs LoggerMessage source generators -->
        <!-- CA1305: Locale-dependent string formatting in logging -->
        <!-- NU1902: Moderate vulnerability audit warning during local dev -->
        <NoWarn>$(NoWarn);CA1716;CA1848;CA1305;NU1902</NoWarn>
    </PropertyGroup>
</Project>
